# ==============================================================================
# Sovereign Vibe Coder — Environment Configuration
# ==============================================================================

# Discord Webhook URL for Pocket Vibe Coding HUD notifications (Optional)
# Leave empty to keep notifications local in ~/.gemini/vibe-progress.log
VIBE_DISCORD_WEBHOOK=""

# 9Router OpenAI-Compatible Endpoint (Default local 9Router port 20128)
# Enables 0-baht image generation (Nano Banana 2) & fleet model sharing
OPENAI_BASE_URL="http://127.0.0.1:20128/v1"
OPENAI_API_KEY="sk-student-vibe-token"

# RTK (Rust Token Killer) Configuration
# Compress CLI command output by 60-90% to prevent context bloat
RTK_ENABLED=1

# Antigravity CLI Preferred Model
# Options: "Gemini 3.8 Flash (High)", "auto"
AGY_DEFAULT_MODEL="Gemini 3.8 Flash (High)"
