{
  "safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{SCRIPTS_DIR}}/safety-gate.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "vibe-progress": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 {{SCRIPTS_DIR}}/vibe-progress.py PreInvocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 {{SCRIPTS_DIR}}/vibe-progress.py Stop",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{SCRIPTS_DIR}}/vibe-progress.py PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{SCRIPTS_DIR}}/vibe-progress.py PostToolUse",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
