{
  "allowNonWorkspaceAccess": true,
  "colorScheme": "dark",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"⚡ Sovereign Vibe Coding Active | 1M Context Engine | Safety Gate Armed | RTK Tokenomics\""
          }
        ]
      }
    ]
  },
  "model": "Gemini 3.8 Flash (High)",
  "permissions": {
    "allow": [
      "command(rtk *)",
      "command(git status)",
      "command(git diff*)",
      "command(npm test)",
      "command(cargo test)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "true",
    "enabled": false
  }
}
