{
  "safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/vibe-kit/scripts/safety-gate.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "vibe-progress": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/vibe-kit/scripts/vibe-progress.py PreInvocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/vibe-kit/scripts/vibe-progress.py Stop",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/vibe-kit/scripts/vibe-progress.py PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/vibe-kit/scripts/vibe-progress.py PostToolUse",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
